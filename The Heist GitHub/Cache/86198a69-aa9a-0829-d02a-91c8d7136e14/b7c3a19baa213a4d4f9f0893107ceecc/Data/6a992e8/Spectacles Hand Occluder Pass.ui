{ 
	"ui": 
	[
		{
        	"label": "Graph Parameters",
        	"widget": "group_start"
        },
{
                	"bindingName": "vertexInset",
                	"label":       "Vertex Inset",
                	"widget":      "slider",
                	"min":         -0.1,
                	"max":         0,
                	"step":        "0.001",
                	"sortIndex":   "0",
                	"hint":        "",
                	"default":     "0.0"
                },

        {
        	"widget": "group_end"
        },
        
		
	{
		"bindingName": "alphaTestThreshold",
		"widget": "slider",
		"min" : 0.0,
		"max" : 1.0,
		"step": 0.001,
		"default": 0.5,
		"hint": "When the 'Alpha Test' blend mode is enabled, pixels with alpha values lower than this disappear."
	}
	
	],
	
	"shaderType": "Mesh3d",
	
