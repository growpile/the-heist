          - SC_ENABLE_RT_RECEIVER
        PassBindings:
          - mLabel: Graph Parameters
            mType: Invalid
            mName: ""
            mWidget: group_start
            mHint: ""
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
              []
          - mLabel: Enable Vertex Color
            mType: Define
            mName: ENABLE_VERTEX_COLOR_BASE
            mWidget: checkbox
            mHint: |-
              Define: ENABLE_VERTEX_COLOR_BASE
              
              When enabled, vertex color acts as an linear multiplier to Albedo.
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
              []
          - mLabel: Enable Lighting
            mType: Define
            mName: ENABLE_GLTF_LIGHTING
            mWidget: checkbox
            mHint: |-
