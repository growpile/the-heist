              []
          - mLabel: Metallic-Roughness
            mType: Invalid
            mName: ""
            mWidget: group_start
            mHint: ""
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
              []
          - mLabel: Base Color
            mType: Property
            mName: baseColorFactor
            mWidget: color
            mHint: |-
              Property: baseColorFactor
              
              Specifies the base color (albedo) of the material if the 'Base Texture' is disabled.  Multiplied with the 'Base Texture' otherwise. 
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: 1.000000
            mValues:
              []
          - mLabel: Base Texture
            mType: Define
            mName: ENABLE_BASE_TEX
            mWidget: group_start
            mHint: |-
              Define: ENABLE_BASE_TEX
              
              Most materials use a base texture (albedo), but disabling it means the base texture will be considered white, and 'Base Color' will solely control the color.
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
              []
          - mLabel: Texture
            mType: Property
            mName: baseColorTexture
            mWidget: texture_group
            mHint: |-
              Property: baseColorTexture
              
              Base Color Texture.
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
              []
          - mLabel: Texture UV
            mType: DefineSelect
            mName: ""
            mWidget: ""
            mHint: Specifies the UV set used.
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
              - mLabel: Mesh UV 0
                mType: DefineSelectValue
                mName: NODE_7_DROPLIST_ITEM 0
                mWidget: ""
                mHint: ""
                mMin: ~
                mMax: ~
                mStep: ~
                mDefaultVal: ~
                mValues:
                  []
              - mLabel: Mesh UV 1
                mType: DefineSelectValue
                mName: NODE_7_DROPLIST_ITEM 1
                mWidget: ""
                mHint: ""
                mMin: ~
                mMax: ~
                mStep: ~
                mDefaultVal: ~
                mValues:
                  []
          - mLabel: ""
            mType: GroupEnd
            mName: ENABLE_BASE_TEX
            mWidget: group_end
            mHint: ""
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
              []
          - mLabel: Emissive Factor
            mType: Property
            mName: emissiveFactor
            mWidget: color
            mHint: |-
              Property: emissiveFactor
              
              The factors for the emissive color of the material.  1 means high intensity, 0 means no light being emitted by the material.  Multiplies the Emissive Texture if enabled.
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: 0.000000
            mValues:
              []
          - mLabel: Emissive Texture
            mType: Define
            mName: ENABLE_EMISSIVE
            mWidget: group_start
            mHint: |-
              Define: ENABLE_EMISSIVE
              
              Enables the emissive texture.
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
              []
          - mLabel: Texture
            mType: Property
            mName: emissiveTexture
            mWidget: texture_group
            mHint: |-
              Property: emissiveTexture
              
              Emissive Texture.
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
              []
          - mLabel: Texture UV
            mType: DefineSelect
            mName: ""
            mWidget: ""
            mHint: Specifies the UV set used.
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
              - mLabel: Mesh UV 0
                mType: DefineSelectValue
                mName: NODE_10_DROPLIST_ITEM 0
                mWidget: ""
                mHint: ""
                mMin: ~
                mMax: ~
                mStep: ~
                mDefaultVal: ~
                mValues:
                  []
              - mLabel: Mesh UV 1
                mType: DefineSelectValue
                mName: NODE_10_DROPLIST_ITEM 1
                mWidget: ""
                mHint: ""
                mMin: ~
                mMax: ~
                mStep: ~
                mDefaultVal: ~
                mValues:
                  []
          - mLabel: ""
            mType: GroupEnd
            mName: ENABLE_EMISSIVE
            mWidget: group_end
            mHint: ""
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
              []
          - mLabel: Normal Map
            mType: Define
            mName: ENABLE_NORMALMAP
            mWidget: group_start
            mHint: |-
              Define: ENABLE_NORMALMAP
              
              Enables the normal map texture and normal mapping. When this is disabled, the per pixel normal is solely determined by the interpolated vertex normals.
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
              []
          - mLabel: Scale
            mType: Property
            mName: normalTextureScale
            mWidget: slider
            mHint: |-
              Property: normalTextureScale
              
              This parameter applied to each normal vector of the 'Normal Map'.
            mMin: 0.000000
            mMax: 1.000000
            mStep: 0.010000
            mDefaultVal: 1.000000
            mValues:
              []
          - mLabel: Texture
            mType: Property
            mName: normalTexture
            mWidget: texture_group
            mHint: |-
              Property: normalTexture
              
              Enables metallic roughness normal map.
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
              []
          - mLabel: Texture UV
            mType: DefineSelect
            mName: ""
            mWidget: ""
            mHint: Specifies the UV set used.
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
              - mLabel: Mesh UV 0
                mType: DefineSelectValue
                mName: NODE_8_DROPLIST_ITEM 0
                mWidget: ""
                mHint: ""
                mMin: ~
                mMax: ~
                mStep: ~
                mDefaultVal: ~
                mValues:
                  []
              - mLabel: Mesh UV 1
                mType: DefineSelectValue
                mName: NODE_8_DROPLIST_ITEM 1
                mWidget: ""
                mHint: ""
                mMin: ~
                mMax: ~
                mStep: ~
                mDefaultVal: ~
                mValues:
                  []
          - mLabel: ""
            mType: GroupEnd
            mName: ENABLE_NORMALMAP
            mWidget: group_end
            mHint: ""
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
              []
          - mLabel: Metallic
            mType: Property
            mName: metallicFactor
            mWidget: slider
            mHint: |-
              Property: metallicFactor
              
              1 means metal, 0 means non-metal (dielectric). Multiplies the metallic channel of the Material Params texture if enabled.
            mMin: 0.000000
            mMax: 1.000000
            mStep: 0.010000
            mDefaultVal: 1.000000
            mValues:
              []
          - mLabel: Roughness
            mType: Property
            mName: roughnessFactor
            mWidget: slider
            mHint: |-
              Property: roughnessFactor
              
              1 means completely rough (diffuse), 0 means perfectly smooth and shiny.  Multiplies the roughness channel of the Material Params texture if enabled.  If your roughness is 1 and your metallic is 0, it's more efficient to disable Specular alltogether.
            mMin: 0.000000
            mMax: 1.000000
            mStep: 0.010000
            mDefaultVal: 1.000000
            mValues:
              []
          - mLabel: Metallic-Roughness Texture
            mType: Define
            mName: ENABLE_METALLIC_ROUGHNESS_TEX
            mWidget: group_start
            mHint: |-
              Define: ENABLE_METALLIC_ROUGHNESS_TEX
              
