          - mLabel: Scale
            mType: Property
            mName: uv2Scale
            mWidget: spinbox
            mHint: |-
              Property: uv2Scale
              
              Allows tiling of textures.
            mMin: ~
            mMax: ~
            mStep: 0.010000
            mDefaultVal: 1.000000
            mValues:
              []
          - mLabel: Offset
            mType: Property
            mName: uv2Offset
            mWidget: spinbox
            mHint: |-
              Property: uv2Offset
              
