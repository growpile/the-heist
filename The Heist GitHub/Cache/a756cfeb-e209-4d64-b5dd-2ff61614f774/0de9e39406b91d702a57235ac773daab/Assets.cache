              Specifies the color of the rim highlight.
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: 1.000000
            mValues:
              []
          - mLabel: Intensity
            mType: Property
            mName: rimIntensity
            mWidget: slider
            mHint: |-
              Property: rimIntensity
              
              Multiplied with 'Rim Color'.
            mMin: 0.000000
            mMax: 10.000000
            mStep: 0.010000
            mDefaultVal: 1.000000
            mValues:
              []
          - mLabel: Exponent
            mType: Property
            mName: rimExponent
            mWidget: slider
            mHint: |-
              Property: rimExponent
              
              Controls the tightness of the rim highlight.
            mMin: 0.000000
            mMax: 10.000000
            mStep: 0.010000
            mDefaultVal: 1.000000
            mValues:
              []
          - mLabel: Invert
            mType: Define
            mName: ENABLE_RIM_INVERT
            mWidget: checkbox
            mHint: |-
              Define: ENABLE_RIM_INVERT
              
              Inverts the effect so it's brighter in the middle of the object and darker at the edge.
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
