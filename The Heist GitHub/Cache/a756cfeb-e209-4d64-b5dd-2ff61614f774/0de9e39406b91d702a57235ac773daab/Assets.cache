              Define: ENABLE_RIM_HIGHLIGHT
              
              'Rim highlight', aka. 'fake Fresnel effect'.
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
            mValues:
              []
          - mLabel: Color
            mType: Property
