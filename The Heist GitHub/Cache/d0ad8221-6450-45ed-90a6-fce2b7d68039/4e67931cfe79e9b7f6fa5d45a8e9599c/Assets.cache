              Specifies the color of the rim highlight.
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: 1.000000
            mValues:
              []
          - mLabel: Intensity
            mType: Property
            mName: rimIntensity
            mWidget: slider
