            mWidget: checkbox
            mHint: |-
              Define: ENABLE_RIM_INVERT
              
              Inverts the effect so it's brighter in the middle of the object and darker at the edge.
            mMin: ~
            mMax: ~
            mStep: ~
            mDefaultVal: ~
