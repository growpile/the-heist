{ 
	"ui": 
	[
		{
        	"label": "Graph Parameters",
        	"widget": "group_start"
        },
{
                	"bindingName": "baseColor",
                	"label":       "Color",
                	"widget":      "color",
                	"sortIndex":   "0",
                	"hint":        "",
                	"default":     "1.0"
                },
                
                {
                	"bindingName": "Tweak_N34",
                	"label":       "Custom Float",
                	"widget":      "spinbox",
                	"step":        "0.01",
                	"sortIndex":   "0",
                	"hint":        "",
                	"default":     "1.0"
                },
                
                {
                	"bindingName": "enableAlbedo",
                	"bindingType": "define",
                	"optimize":    true,
                	"label":       "Enable Albedo",
                	"widget":      "checkbox",
                	"sortIndex":   "1",
                	"hint":        ""
                },
                
                { 
                	"bindingName": "albedoTex", 
                	"label":       "Albedo", 
                	"widget":      "texture_group",
                	"sortIndex":   "2",
                	"hint":        ""
                },
                
                {
                	"bindingName": "enableNormals",
                	"bindingType": "define",
                	"optimize":    true,
                	"label":       "Enable Normals",
                	"widget":      "checkbox",
                	"sortIndex":   "3",
                	"hint":        ""
                },
                
                { 
                	"bindingName": "normalTex", 
                	"label":       "Normals", 
                	"widget":      "texture_group",
                	"sortIndex":   "4",
                	"hint":        ""
                },
                
                {
                	"bindingName": "enableAO",
                	"bindingType": "define",
                	"optimize":    true,
                	"label":       "Enable AO",
                	"widget":      "checkbox",
                	"sortIndex":   "5",
                	"hint":        ""
                },
                
                {
                	"bindingName": "aoScale",
                	"label":       "AO Scale",
                	"widget":      "slider",
                	"min":         0,
                	"max":         1,
                	"step":        "0.01",
                	"sortIndex":   "6",
                	"hint":        "",
                	"default":     "1.0"
                },
                
                { 
                	"bindingName": "aoTex", 
                	"label":       "Ambien Occlusion", 
                	"widget":      "texture_group",
                	"sortIndex":   "7",
                	"hint":        ""
                },
                
                {
                	"bindingName": "enableRim",
                	"bindingType": "define",
                	"optimize":    true,
                	"label":       "Enable Rim Light",
                	"widget":      "checkbox",
                	"sortIndex":   "8",
                	"hint":        ""
                },
                
                {
                	"bindingName": "rimColor",
                	"label":       "Rim Color",
                	"widget":      "color",
                	"sortIndex":   "9",
                	"hint":        "",
                	"default":     "1.0"
                },
                
                {
                	"bindingName": "rimExponent",
                	"label":       "Exponent",
                	"widget":      "slider",
                	"min":         -5,
                	"max":         5,
                	"step":        "0.01",
                	"sortIndex":   "10",
                	"hint":        "",
                	"default":     "5.0"
                },
                
                {
                	"bindingName": "rimIntensity",
                	"label":       "Intensity",
                	"widget":      "slider",
                	"min":         -5,
                	"max":         5,
                	"step":        "0.01",
                	"sortIndex":   "11",
                	"hint":        "",
                	"default":     "1.0"
                },
                
                {
                	"bindingName": "metallic",
                	"label":       "Metallic",
                	"widget":      "slider",
                	"min":         0,
                	"max":         1,
                	"step":        "0.01",
                	"sortIndex":   "12",
                	"hint":        "",
                	"default":     "1.0"
                },
                
                {
                	"bindingName": "roughness",
                	"label":       "Roughness",
                	"widget":      "slider",
                	"min":         0,
                	"max":         1,
                	"step":        "0.01",
                	"sortIndex":   "13",
                	"hint":        "",
                	"default":     "1.0"
                },

        {
        	"widget": "group_end"
        },
        
		
	{
		"bindingName": "alphaTestThreshold",
		"widget": "slider",
		"min" : 0.0,
		"max" : 1.0,
		"step": 0.001,
		"default": 0.5,
		"hint": "When the 'Alpha Test' blend mode is enabled, pixels with alpha values lower than this disappear."
	}
	
	],
	
	"shaderType": "Mesh3d",
	
	"extraDefines":
	[
		"SC_ENABLE_RT_CASTER",
		"SC_ENABLE_RT_RECEIVER"
	]
}
